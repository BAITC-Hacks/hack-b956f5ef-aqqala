# Скопируйте в .env и заполните. Без ключа агент работает в режиме правил.
# Провайдер: openai или nvidia (NVIDIA NIM, OpenAI-совместимый API)
LLM_PROVIDER=openai
# Модель (необязательно). По умолчанию: openai → gpt-4.1-mini, nvidia → meta/llama-3.3-70b-instruct
LLM_MODEL=
OPENAI_API_KEY=
NVIDIA_API_KEY=
